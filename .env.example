# Never commit actual credentials. Set these as secrets in Coolify.
POSTGRES_ADMIN_DSN=postgresql://postgres:replace-password@your-postgres-container:5432/postgres
APP_DB_HOST=your-postgres-container
APP_DB_PORT=5432
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-generated-fernet-key

# Optional: use Coolify's own API to attach databases and redeploy applications.
COOLIFY_API_URL=https://coolify.example.com/api/v1
COOLIFY_API_TOKEN=replace-with-coolify-api-token
# Only for an HTTP endpoint on a trusted private network. Avoid over public networks.
# COOLIFY_ALLOW_HTTP=true
